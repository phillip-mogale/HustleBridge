---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | HustleBridge">
  <main class="wrap" style="padding-block:96px;max-width:640px" id="view">
    <h1 class="h-page">That page is not here.</h1>
    <p class="p-page">The link may be old or mistyped. Your work is saved on this device, so nothing is lost.</p>
    <div class="cta-row"><a class="btn" href="/dashboard">Go to my home</a><a class="btn ghost" style="color:var(--text)" href="/">Back to the start</a></div>
  </main>
</Base>
